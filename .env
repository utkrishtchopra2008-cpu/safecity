# Local development defaults only. Never use these values in production.
APP_ENV=development
LOG_LEVEL=INFO
API_PREFIX=/api/v1
PUBLIC_APP_ORIGIN=http://localhost:5173

# Local PostgreSQL used by compose.yaml
POSTGRES_USER=safecity_dev
POSTGRES_PASSWORD=local_dev_only_change_me
POSTGRES_DB=safecity_dev
DATABASE_URL=postgresql+psycopg://safecity_dev:local_dev_only_change_me@127.0.0.1:5432/safecity_dev
SESSION_TTL_SECONDS=28800
SESSION_IDLE_TTL_SECONDS=1800
# Required in production: at least 32 random characters; keep backend-only.
SESSION_CSRF_SECRET=

# Session/security defaults for local development; production must use HTTPS and secure cookies.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CSRF_ALLOWED_ORIGINS=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Private local media configuration for later implementation phases
LOCAL_MEDIA_ROOT=.data/media
STORAGE_BACKEND=local
MAX_UPLOAD_BYTES=104857600
MAX_UPLOAD_DURATION_SECONDS=900

# Optional private Supabase Storage. Configure only on the backend/deployment.
# Keep the bucket private and apply policies documented in docs/supabase-storage.md.
SUPABASE_URL=https://gqdpvwrwmlpvitzhbozb.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_publishable_m3kGoIpBPuwhJlC0Y98YuA_zaY6vhG4
SUPABASE_STORAGE_BUCKET=safecity-evidence

DETECTOR_BACKEND=simulated
DETECTOR_VERSION=simulated-v1
DETECTOR_MODEL_DIR=../.data/models
# Optional quality-warning thresholds; blank means measure only, no uncertainty decision.
# Values are deployment choices, not validated production-policy defaults.
QUALITY_MIN_MEAN_LUMA=
QUALITY_MAX_MEAN_LUMA=
QUALITY_MIN_LAPLACIAN_VARIANCE=
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_MAX_ATTEMPTS=3

# TinyFish is disabled by default. Add a key only to a local, untracked .env when approved.
TINYFISH_CONTEXT_ENABLED=false
TINYFISH_API_KEY=sk-tinyfish-2lwfQmLezMohtx31eJkTo6WNBOw-HPg1
TINYFISH_REQUEST_TIMEOUT_SECONDS=15
TINYFISH_MAX_RESULTS_PER_REFRESH=5
TINYFISH_CONTEXT_TTL_SECONDS=1800
TINYFISH_ALLOWED_DOMAINS=

# Vite dev-server proxy target; not a browser-visible secret.
API_PROXY_TARGET=http://127.0.0.1:8000
VITE_API_BASE_URL=/api/v1
